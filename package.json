{
    "name": "GlobalSync",
    "version": "1.0.0",
    "private": true,
    "workspaces": {
        "nohoist": [
            "**"
        ],
        "packages": [
            "./packages/*"
        ]
    },
    "main": "src/main.js",
    "type": "commonjs",
    "scripts": {
        "dev": "./node_modules/.bin/vite",
        "build": "./node_modules/.bin/vite build",
        "preview": "./node_modules/.bin/vite preview",
        "start": "./node_modules/.bin/electron src/main.js",
        "package": "yarn build && ./node_modules/.bin/electron-builder",
        "make": "yarn build && ./node_modules/.bin/electron-builder",
        "publish": "yarn build && ./node_modules/.bin/electron-builder --publish always"
    },
    "build": {
        "appId": "com.brantleyglobal.globalsync",
        "productName": "GlobalSync",
        "directories": {
            "output": "dist_electron"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "brantleyglobal",
                "repo": "globalsync-partner"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "./assets/logo.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "./assets/logo.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Finance"
        }
    },
    "devDependencies": {
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@vitejs/plugin-react": "^4.7.0",
        "electron": "^31.7.7",
        "electron-builder": "^26.15.3",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-plugin-electron": "^1.0.4",
        "vite-plugin-static-copy": "^4.1.1",
        "wrangler": "^4.32.0"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.0",
        "dotenv": "^17.4.2",
        "electron-updater": "^6.8.9",
        "ethers": "^6.16.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "viem": "^2.52.2",
        "wagmi": "^3.6.16",
        "web3": "^4.16.0"
    },
    "resolutions": {
        "electron/@electron/get": "3.0.0",
        "electron/@electron-internal/extract-zip": "1.0.2",
        "yauzl": "^3.3.1"
    },
    "config": {
        "forge": {
            "packagerConfig": {
                "asar": true,
                "icon": "./assets/logo",
                "ignore": [
                    "^/\\.github",
                    "^/\\.git",
                    "^/src/renderer/(?!(index\\.html|index\\.jsx)$)",
                    "^/vitest\\.config",
                    "^/wrangler\\.toml",
                    "^/\\.cloudflare"
                ]
            },
            "makers": [
                {
                    "name": "@electron-forge/maker-squirrel",
                    "config": {
                        "name": "GlobalSync",
                        "setupIcon": "./assets/logo.ico"
                    }
                },
                {
                    "name": "@electron-forge/maker-zip",
                    "platforms": [
                        "darwin"
                    ]
                },
                {
                    "name": "@electron-forge/maker-dmg",
                    "config": {
                        "icon": "./assets/logo.icns",
                        "format": "ULFO"
                    }
                },
                {
                    "name": "@electron-forge/maker-deb",
                    "config": {
                        "options": {
                            "icon": "./assets/logo.png",
                            "categories": [
                                "Finance"
                            ]
                        }
                    }
                },
                {
                    "name": "@electron-forge/maker-rpm",
                    "config": {}
                }
            ],
            "publishers": [
                {
                    "name": "@electron-forge/publisher-github",
                    "config": {
                        "repository": {
                            "owner": "brantleyglobal",
                            "name": "globalsync-partner"
                        },
                        "draft": true
                    }
                }
            ]
        }
    },
    "description": "GlobalSync decentralized operations and capital manager dashboard.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/brantleyglobal/globalsync-partner.git"
    },
    "keywords": [],
    "author": "Brantley Global <global@brantleyglobal.com>",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/brantleyglobal/globalsync-partner/issues"
    },
    "homepage": "https://github.com/brantleyglobal/globalsync-partner#readme",
    "packageManager": "yarn@1.22.22"
}
